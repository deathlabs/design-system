{
  "name": "@deathlabs/design-system",
  "version": "0.1.0",
  "description": "Deathlabs design system for Material UI applications",
  "keywords": [
    "material-ui",
    "mui",
    "design-system",
    "theme-provider",
    "deathlabs"
  ],
  "homepage": "https://github.com/deathlabs/design-system#readme",
  "bugs": {
    "url": "https://github.com/deathlabs/design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deathlabs/design-system.git"
  },
  "license": "MIT",
  "author": "Victor Fernandez III",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-storybook": "storybook build",
    "check": "prettier --check --ignore-path .prettierignore . && tsc -p tsconfig.json --noEmit",
    "format": "prettier --write --ignore-path .prettierignore .",
    "storybook": "storybook dev -p 6006",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
